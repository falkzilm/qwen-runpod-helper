# Select exactly one backend: serverless (default) or local.
INFERENCE_MODE=serverless

# Open WebUI + SearXNG are always local at http://localhost:3000.
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_VERSION=0.11.3
WEBUI_SECRET_KEY=replace-with-openssl-rand-hex-32
WEBUI_ADMIN_EMAIL=admin@example.invalid
WEBUI_ADMIN_PASSWORD=replace-with-strong-password
SEARXNG_SECRET=replace-with-openssl-rand-hex-32
ENABLE_WEB_SEARCH=true
SEARXNG_LANGUAGE=de-DE
WEB_SEARCH_RESULT_COUNT=5

# Optional for an additional reliable broad-web source. Without it SearXNG
# uses several free public engines and tolerates individual blocks.
BRAVE_SEARCH_API_KEY=

# Serverless mode: Open WebUI and the CLI authenticate against RunPod.
# Either just the ID (abc123) or the complete endpoint URL is accepted.
RUNPOD_ENDPOINT_ID=replace-with-endpoint-id
RUNPOD_API_KEY=replace-with-runpod-api-key
# `make warmup` triggers a cold start and polls /v1/models until ready.
# A Qwen cold start can take several minutes; increase when the selected GPU
# regularly needs longer.
RUNPOD_COLD_START_TIMEOUT=900
RUNPOD_READINESS_INTERVAL=10
# Optional: use this instead of RUNPOD_ENDPOINT_ID for a compatible custom URL.
# RUNPOD_API_BASE_URL=https://ENDPOINT_ID.api.runpod.ai

# Local mode: start the same worker image with `make local-up`.
LOCAL_VLLM_BASE_URL=http://worker:8000/v1
LOCAL_VLLM_PORT=8000
LOCAL_VLLM_API_KEY=replace-with-openssl-rand-hex-32
HF_TOKEN=hf_replace_me
MODEL_NAME=orcarouter/Qwen3.8-27B-Uncensored-FP8
SERVED_MODEL_NAME=qwen3.8-27b-uncensored
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=4
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=true
SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":3}
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
