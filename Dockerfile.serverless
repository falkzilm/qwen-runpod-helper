# syntax=docker/dockerfile:1.7
ARG VLLM_VERSION=0.28.0
FROM vllm/vllm-openai:v${VLLM_VERSION}

LABEL org.opencontainers.image.title="Qwen RunPod Serverless Worker" \
      org.opencontainers.image.description="OpenAI-compatible vLLM worker for RunPod Serverless load-balancing endpoints" \
      org.opencontainers.image.licenses="MIT"

COPY serverless/start.sh /opt/qwen-serverless/start.sh
RUN chmod 0755 /opt/qwen-serverless/start.sh

# RunPod Load Balancer workers use port 80 by default. The local Compose stack
# explicitly overrides PORT to 8000, avoiding a privileged host port locally.
EXPOSE 80
ENTRYPOINT ["/opt/qwen-serverless/start.sh"]
