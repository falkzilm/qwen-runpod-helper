# Model profile
MODEL_NAME=orcarouter/Qwen3.8-27B-Uncensored-FP8
SERVED_MODEL_NAME=qwen3.8-27b-uncensored
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=4
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=true
SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":3}
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder

# Persistent Open WebUI state. /workspace must be the Pod volume mount.
DATA_DIR=/workspace/open-webui

# Cheapest profile: model cache is erased when the Pod stops.
MODEL_CACHE_DIR=/root/.cache/huggingface

# Faster but more expensive alternative: use a >=50 GB persistent volume and:
# MODEL_CACHE_DIR=/workspace/huggingface

# Secrets: generate unique values; never commit the real file.
HF_TOKEN=hf_replace_me
WEBUI_SECRET_KEY=replace-with-openssl-rand-hex-32
VLLM_INTERNAL_API_KEY=replace-with-openssl-rand-hex-32
WEBUI_ADMIN_EMAIL=admin@example.invalid
WEBUI_ADMIN_PASSWORD=replace-with-strong-password
