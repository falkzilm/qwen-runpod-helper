# RunPod Serverless Load-Balancer worker
MODEL_NAME=orcarouter/Qwen3.8-27B-Uncensored-FP8
SERVED_MODEL_NAME=qwen3.8-27b-uncensored
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=4
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=true
SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":3}
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder

# Set this in the private RunPod endpoint for gated models. Do not commit it.
HF_TOKEN=hf_replace_me

# RunPod uses PORT=80 for Load-Balancer workers. Expose HTTP port 80 and set
# HEALTH_CHECK_PATH=/health in the endpoint configuration. Do not set
# VLLM_API_KEY on RunPod: the public endpoint is authenticated with
# RUNPOD_API_KEY instead.
